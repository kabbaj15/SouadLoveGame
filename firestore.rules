rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signed() { return request.auth != null; }
  function member(data) { return signed() && request.auth.uid in data.members.keys(); }
  function validMember(m) { return m.keys().hasOnly(['seat','display_name']) && m.seat in [1,2] && m.display_name is string && m.display_name.size() <= 24; }
  match /rooms/{code} {
   allow get: if signed();
   allow list: if false;
   allow create: if signed() && code.matches('[A-HJ-NP-Z2-9]{12}') && request.resource.data.keys().hasOnly(['code','owner','members','version','scores','state','createdAt']) && request.resource.data.code == code && request.resource.data.owner == request.auth.uid && request.resource.data.members.keys().size() == 1 && request.auth.uid in request.resource.data.members.keys() && validMember(request.resource.data.members[request.auth.uid]) && request.resource.data.members[request.auth.uid].seat == 1 && request.resource.data.version == 0;
   allow update: if signed() && (
    (member(resource.data) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state','scores','version']) && request.resource.data.version == resource.data.version + 1 && request.resource.data.members == resource.data.members && request.resource.data.owner == resource.data.owner)
    || (!member(resource.data) && resource.data.members.keys().size() == 1 && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']) && request.resource.data.members.keys().size() == 2 && request.resource.data.members[request.auth.uid].seat == 2 && validMember(request.resource.data.members[request.auth.uid]) && request.resource.data.members[resource.data.owner] == resource.data.members[resource.data.owner])
   );
   allow delete: if false;
   match /messages/{messageId} {
    allow read: if member(get(/databases/$(database)/documents/rooms/$(code)).data);
    allow create: if member(get(/databases/$(database)/documents/rooms/$(code)).data) && request.resource.data.keys().hasOnly(['user_id','body','created_at']) && request.resource.data.user_id == request.auth.uid && request.resource.data.body is string && request.resource.data.body.size() > 0 && request.resource.data.body.size() <= 500 && request.resource.data.created_at == request.time;
    allow update, delete: if false;
   }
  }
 }
}
